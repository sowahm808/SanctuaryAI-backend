NODE_ENV=development
PORT=3000
# Firebase Web API key is an identifier, not an Admin credential. Restrict it in Google Cloud.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
# Store these service-account values in a secret manager in production.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
# Optional local emulator endpoints (omit in production).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
REDIS_URL=redis://redis:6379
TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
CORS_ORIGINS=http://localhost:3001
OPENAI_API_KEY=
SWAGGER_ENABLED=true
# Optional development-only account. Leave unset for a credential-free seed.
DEV_SUPER_ADMIN_EMAIL=
DEV_SUPER_ADMIN_PASSWORD=
