generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum UserStatus { PENDING ACTIVE SUSPENDED DISABLED }
enum OrganizationStatus { ACTIVE SUSPENDED ARCHIVED }
enum MembershipStatus { INVITED ACTIVE SUSPENDED REVOKED }
enum ContentStatus { DRAFT IN_REVIEW CHANGES_REQUESTED APPROVED REJECTED PUBLISHED ARCHIVED }
enum ApprovalStatus { NOT_REQUIRED PENDING APPROVED REJECTED CHANGES_REQUESTED }
enum SocialPlatform { FACEBOOK INSTAGRAM TIKTOK }
enum SocialPostStatus { DRAFT SCHEDULED PUBLISHING PARTIALLY_PUBLISHED PUBLISHED FAILED CANCELLED }
enum PublishingJobStatus { PENDING QUEUED PROCESSING SUCCEEDED FAILED CANCELLED DEAD_LETTER }
enum AiGenerationStatus { QUEUED PROCESSING SUCCEEDED FAILED CANCELLED }
enum MediaAssetStatus { PENDING_UPLOAD PROCESSING READY QUARANTINED FAILED ARCHIVED }
enum RenderStatus { NOT_STARTED QUEUED RENDERING COMPLETED FAILED CANCELLED }
enum NotificationType { INVITATION APPROVAL_REQUESTED CHANGES_REQUESTED APPROVED REJECTED POST_PUBLISHED POST_FAILED TOKEN_EXPIRING CONNECTION_LOST RENDER_COMPLETED RENDER_FAILED }
enum CampaignStatus { DRAFT GENERATING IN_REVIEW APPROVED ACTIVE COMPLETED ARCHIVED FAILED }
model User { id String @id @default(uuid()) @db.Uuid email String @unique normalizedEmail String @unique passwordHash String displayName String firstName String? lastName String? avatarUrl String? emailVerifiedAt DateTime? status UserStatus @default(PENDING) failedLoginCount Int @default(0) lockedUntil DateTime? lastLoginAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? memberships Membership[] sessions AuthSession[] notifications Notification[] @@index([status,deletedAt]) }
model Organization { id String @id @default(uuid()) @db.Uuid name String slug String @unique status OrganizationStatus @default(ACTIVE) timezone String @default("UTC") subscriptionPlan String @default("FREE") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt deletedAt DateTime? memberships Membership[] roles Role[] churchProfile ChurchProfile? brandKit BrandKit? campaigns MonthlyCampaign[] themes MonthlyTheme[] sermons Sermon[] socialAccounts SocialAccount[] socialPosts SocialPost[] approvals ApprovalRequest[] auditLogs AuditLog[] @@index([status,deletedAt]) }
model Membership { id String @id @default(uuid()) @db.Uuid userId String @db.Uuid organizationId String @db.Uuid roleId String @db.Uuid status MembershipStatus @default(INVITED) invitedBy String? @db.Uuid joinedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id]) organization Organization @relation(fields:[organizationId],references:[id]) role Role @relation(fields:[roleId],references:[id]) @@unique([userId,organizationId]) @@index([organizationId,status]) }
model Role { id String @id @default(uuid()) @db.Uuid organizationId String? @db.Uuid name String description String isSystemRole Boolean @default(false) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt organization Organization? @relation(fields:[organizationId],references:[id]) memberships Membership[] permissions RolePermission[] @@unique([organizationId,name]) }
model Permission { id String @id @default(uuid()) @db.Uuid code String @unique description String roles RolePermission[] }
model RolePermission { roleId String @db.Uuid permissionId String @db.Uuid role Role @relation(fields:[roleId],references:[id],onDelete:Cascade) permission Permission @relation(fields:[permissionId],references:[id],onDelete:Cascade) @@id([roleId,permissionId]) }
model AuthSession { id String @id @default(uuid()) @db.Uuid userId String @db.Uuid refreshTokenHash String @unique familyId String @db.Uuid expiresAt DateTime revokedAt DateTime? replacedById String? @db.Uuid ipAddress String? userAgent String? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,revokedAt]) }
model ChurchProfile { id String @id @default(uuid()) @db.Uuid organizationId String @unique @db.Uuid churchName String slogan String? description String? seniorPastorName String? addressLine1 String? addressLine2 String? city String? region String? country String? digitalAddress String? phone String? email String? website String? serviceScheduleJson Json? preferredBibleTranslation String? ministryTone String? statementOfFaith String? doctrinalGuidelines String? prohibitedContent String? standardHashtags Json? defaultFooter String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt organization Organization @relation(fields:[organizationId],references:[id]) }
model BrandKit { id String @id @default(uuid()) @db.Uuid organizationId String @unique @db.Uuid primaryLogoAssetId String? @db.Uuid secondaryLogoAssetId String? @db.Uuid primaryColor String? secondaryColor String? accentColor String? backgroundColor String? headingFont String? bodyFont String? brandGuidelines String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt organization Organization @relation(fields:[organizationId],references:[id]) }
model MonthlyCampaign { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid month Int year Int title String spiritualFocus String? mainScripture String? supportingScripturesJson Json? numberOfSundays Int majorEventsJson Json? tone String? bibleTranslation String? status CampaignStatus @default(DRAFT) progressPercent Int @default(0) createdBy String @db.Uuid approvedBy String? @db.Uuid approvedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt archivedAt DateTime? organization Organization @relation(fields:[organizationId],references:[id]) themes MonthlyTheme[] sermons Sermon[] @@unique([organizationId,month,year]) @@index([organizationId,status,year,month]) }
model MonthlyTheme { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid campaignId String @db.Uuid title String subtitle String? mainScripture String supportingScripturesJson Json? explanation String? pastoralIntroduction String? spiritualObjectivesJson Json? weeklyTeachingDirectionJson Json? monthlyConfession String? monthlyDeclaration String? suggestedHashtagsJson Json? flyerHeadline String? designConcept String? status ContentStatus @default(DRAFT) version Int @default(1) createdBy String @db.Uuid approvedBy String? @db.Uuid approvedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt organization Organization @relation(fields:[organizationId],references:[id]) campaign MonthlyCampaign @relation(fields:[campaignId],references:[id]) @@index([organizationId,status]) }
model Sermon { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid campaignId String? @db.Uuid seriesId String? @db.Uuid title String serviceDate DateTime? speakerName String? mainScripture String? supportingScripturesJson Json? bibleTranslation String? targetAudience String? targetDurationMinutes Int? tone String? objective String? outlineJson Json? manuscriptJson Json? manuscriptText String? altarCall String? conclusion String? status ContentStatus @default(DRAFT) currentVersion Int @default(1) createdBy String @db.Uuid approvedBy String? @db.Uuid approvedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt archivedAt DateTime? organization Organization @relation(fields:[organizationId],references:[id]) campaign MonthlyCampaign? @relation(fields:[campaignId],references:[id]) versions SermonVersion[] @@index([organizationId,status,serviceDate]) }
model SermonVersion { id String @id @default(uuid()) @db.Uuid sermonId String @db.Uuid version Int contentJson Json contentText String? changeSummary String? createdBy String @db.Uuid createdAt DateTime @default(now()) sermon Sermon @relation(fields:[sermonId],references:[id],onDelete:Cascade) @@unique([sermonId,version]) }
model SocialAccount { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid platform SocialPlatform platformAccountId String accountName String accountType String encryptedAccessToken String encryptedRefreshToken String? tokenExpiresAt DateTime? scopesJson Json capabilitiesJson Json status String lastSyncedAt DateTime? connectedBy String @db.Uuid createdAt DateTime @default(now()) updatedAt DateTime @updatedAt organization Organization @relation(fields:[organizationId],references:[id]) jobs PublishingJob[] @@unique([organizationId,platform,platformAccountId]) }
model SocialPost { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid campaignId String? @db.Uuid title String contentType String body String hashtagsJson Json? mediaAssetIdsJson Json? platformsJson Json scheduledAt DateTime? timezone String status SocialPostStatus @default(DRAFT) approvalStatus ApprovalStatus @default(PENDING) createdBy String @db.Uuid approvedBy String? @db.Uuid approvedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt organization Organization @relation(fields:[organizationId],references:[id]) jobs PublishingJob[] @@index([organizationId,status,scheduledAt]) }
model PublishingJob { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid socialPostId String @db.Uuid socialAccountId String @db.Uuid platform SocialPlatform scheduledAt DateTime startedAt DateTime? completedAt DateTime? status PublishingJobStatus @default(PENDING) attemptCount Int @default(0) maximumAttempts Int @default(5) platformPostId String? platformPostUrl String? requestPayloadJson Json? responsePayloadJson Json? errorCode String? errorMessage String? correlationId String @db.Uuid createdAt DateTime @default(now()) updatedAt DateTime @updatedAt socialPost SocialPost @relation(fields:[socialPostId],references:[id]) socialAccount SocialAccount @relation(fields:[socialAccountId],references:[id]) @@unique([socialPostId,socialAccountId]) @@index([organizationId,status,scheduledAt]) }
model ApprovalRequest { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid resourceType String resourceId String @db.Uuid requestedBy String @db.Uuid assignedReviewerId String? @db.Uuid status ApprovalStatus @default(PENDING) decision String? decisionNotes String? requestedAt DateTime @default(now()) reviewedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt organization Organization @relation(fields:[organizationId],references:[id]) comments ReviewComment[] @@index([organizationId,status]) }
model ReviewComment { id String @id @default(uuid()) @db.Uuid approvalRequestId String @db.Uuid userId String @db.Uuid parentCommentId String? @db.Uuid fieldPath String? body String resolvedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt approval ApprovalRequest @relation(fields:[approvalRequestId],references:[id],onDelete:Cascade) }
model Notification { id String @id @default(uuid()) @db.Uuid userId String @db.Uuid organizationId String @db.Uuid type NotificationType title String message String actionUrl String? readAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id]) @@index([userId,organizationId,readAt]) }
model AuditLog { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid actorUserId String? @db.Uuid action String resourceType String resourceId String? @db.Uuid beforeJson Json? afterJson Json? ipAddress String? userAgent String? correlationId String @db.Uuid createdAt DateTime @default(now()) organization Organization @relation(fields:[organizationId],references:[id]) @@index([organizationId,createdAt]) }
