generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  LINKEDIN
  X
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PARTIALLY_PUBLISHED
  PUBLISHED
  FAILED
  CANCELLED
}

enum PublishingJobStatus {
  PENDING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTER
}

enum AiGenerationStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum MediaAssetStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  QUARANTINED
  FAILED
  ARCHIVED
}

enum RenderStatus {
  NOT_STARTED
  QUEUED
  RENDERING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationType {
  INVITATION
  APPROVAL_REQUESTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  POST_PUBLISHED
  POST_FAILED
  TOKEN_EXPIRING
  CONNECTION_LOST
  RENDER_COMPLETED
  RENDER_FAILED
  SECURITY
}

enum CampaignStatus {
  DRAFT
  GENERATING
  IN_REVIEW
  APPROVED
  ACTIVE
  COMPLETED
  ARCHIVED
  FAILED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum IngestionStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum CalendarItemType {
  SERMON
  EVENT
  CAMPAIGN
  SOCIAL_POST
  DEADLINE
}

enum ProjectType {
  FLYER
  VIDEO
}

enum AnalyticsPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id               String         @id @default(uuid()) @db.Uuid
  email            String         @unique
  normalizedEmail  String         @unique
  passwordHash     String
  displayName      String
  firstName        String?
  lastName         String?
  avatarUrl        String?
  emailVerifiedAt  DateTime?
  status           UserStatus     @default(PENDING)
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  memberships      Membership[]
  sessions         AuthSession[]
  notifications    Notification[]

  @@index([status, deletedAt, id])
}

model Organization {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  slug             String             @unique
  status           OrganizationStatus @default(ACTIVE)
  timezone         String             @default("UTC")
  subscriptionPlan String             @default("FREE")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  memberships      Membership[]
  roles            Role[]
  churchProfile    ChurchProfile?
  brandKit         BrandKit?
  campaigns        MonthlyCampaign[]

  @@index([status, deletedAt, id])
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  roleId         String           @db.Uuid
  status         MembershipStatus @default(INVITED)
  invitedById    String?          @db.Uuid
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, status, deletedAt, id])
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @db.Uuid
  name           String
  description    String
  isSystemRole   Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  memberships    Membership[]
  permissions    RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt, id])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
}

model AuthSession {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  activeOrganizationId String?   @db.Uuid
  refreshTokenHash     String    @unique
  familyId             String    @db.Uuid
  expiresAt            DateTime
  revokedAt            DateTime?
  replacedById         String?   @db.Uuid
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, revokedAt, expiresAt, id])
  @@index([familyId])
}

model VerificationToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  purpose    TokenPurpose @default(EMAIL_VERIFICATION)
  tokenHash  String       @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId, purpose, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  email           String
  normalizedEmail String
  roleId          String           @db.Uuid
  invitedById     String           @db.Uuid
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, normalizedEmail, status])
  @@index([organizationId, status, expiresAt, id])
}

model ChurchProfile {
  id                        String       @id @default(uuid()) @db.Uuid
  organizationId            String       @unique @db.Uuid
  churchName                String
  slogan                    String?
  description               String?
  seniorPastorName          String?
  addressJson               Json?
  phone                     String?
  email                     String?
  website                   String?
  serviceScheduleJson       Json?
  preferredBibleTranslation String?
  ministryTone              String?
  statementOfFaith          String?
  doctrinalGuidelines       String?
  prohibitedContent         String?
  standardHashtags          Json?
  defaultFooter             String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  deletedAt                 DateTime?
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model BrandKit {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @unique @db.Uuid
  primaryLogoAssetId   String?      @db.Uuid
  secondaryLogoAssetId String?      @db.Uuid
  primaryColor         String?
  secondaryColor       String?
  accentColor          String?
  backgroundColor      String?
  headingFont          String?
  bodyFont             String?
  brandGuidelines      String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  primaryLogoAsset     MediaAsset?  @relation("PrimaryLogo", fields: [primaryLogoAssetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  secondaryLogoAsset   MediaAsset?  @relation("SecondaryLogo", fields: [secondaryLogoAssetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
}

model MonthlyCampaign {
  id                       String                 @id @default(uuid()) @db.Uuid
  organizationId           String                 @db.Uuid
  month                    Int
  year                     Int
  title                    String
  spiritualFocus           String?
  mainScripture            String?
  supportingScripturesJson Json?
  numberOfSundays          Int?
  majorEventsJson          Json?
  tone                     String?
  bibleTranslation         String?
  status                   CampaignStatus         @default(DRAFT)
  progressPercent          Int                    @default(0)
  createdById              String                 @db.Uuid
  approvedById             String?                @db.Uuid
  approvedAt               DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  deletedAt                DateTime?
  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  themes                   MonthlyTheme[]
  series                   SermonSeries[]
  sermons                  Sermon[]
  prayerCollections        PrayerCollection[]
  declarations             PropheticDeclaration[]

  @@unique([organizationId, month, year])
  @@index([organizationId, status, year, month, deletedAt, id])
}

model MonthlyTheme {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  campaignId     String          @db.Uuid
  title          String
  subtitle       String?
  mainScripture  String
  contentJson    Json
  status         ContentStatus   @default(DRAFT)
  currentVersion Int             @default(1)
  createdById    String          @db.Uuid
  approvedById   String?         @db.Uuid
  approvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  campaign       MonthlyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  versions       ThemeVersion[]

  @@index([organizationId, status, deletedAt, id])
  @@index([organizationId, campaignId])
}

model ThemeVersion {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  themeId        String         @db.Uuid
  version        Int
  editorId       String         @db.Uuid
  changeSummary  String
  snapshot       Json
  diff           Json?
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  theme          MonthlyTheme   @relation(fields: [themeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([themeId, version])
  @@index([organizationId, themeId, createdAt, id])
}

model SermonSeries {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  campaignId     String?          @db.Uuid
  title          String
  description    String?
  status         ContentStatus    @default(DRAFT)
  createdById    String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  campaign       MonthlyCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sermons        Sermon[]

  @@unique([organizationId, title])
  @@index([organizationId, status, deletedAt, id])
}

model Sermon {
  id                    String           @id @default(uuid()) @db.Uuid
  organizationId        String           @db.Uuid
  campaignId            String?          @db.Uuid
  seriesId              String?          @db.Uuid
  title                 String
  serviceDate           DateTime?
  speakerName           String?
  contentJson           Json
  targetDurationMinutes Int?
  status                ContentStatus    @default(DRAFT)
  currentVersion        Int              @default(1)
  createdById           String           @db.Uuid
  approvedById          String?          @db.Uuid
  approvedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?
  campaign              MonthlyCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  series                SermonSeries?    @relation(fields: [seriesId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  versions              SermonVersion[]

  @@index([organizationId, status, serviceDate, deletedAt, id])
}

model SermonVersion {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  sermonId       String         @db.Uuid
  version        Int
  editorId       String         @db.Uuid
  changeSummary  String
  snapshot       Json
  diff           Json?
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  sermon         Sermon         @relation(fields: [sermonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([sermonId, version])
  @@index([organizationId, sermonId, createdAt, id])
}

model PrayerCollection {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  campaignId     String?          @db.Uuid
  sermonId       String?          @db.Uuid
  title          String
  status         ContentStatus    @default(DRAFT)
  currentVersion Int              @default(1)
  createdById    String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  campaign       MonthlyCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  points         PrayerPoint[]
  versions       PrayerVersion[]

  @@index([organizationId, status, deletedAt, id])
}

model PrayerPoint {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  collectionId   String           @db.Uuid
  sequence       Int
  title          String?
  text           String
  scripture      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  collection     PrayerCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([collectionId, sequence])
  @@index([organizationId, collectionId, deletedAt, id])
}

model PrayerVersion {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  collectionId   String           @db.Uuid
  version        Int
  editorId       String           @db.Uuid
  changeSummary  String
  snapshot       Json
  diff           Json?
  approvalStatus ApprovalStatus   @default(PENDING)
  createdAt      DateTime         @default(now())
  collection     PrayerCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([collectionId, version])
  @@index([organizationId, collectionId, createdAt, id])
}

model PropheticDeclaration {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  campaignId     String?              @db.Uuid
  title          String
  text           String
  scripture      String?
  status         ContentStatus        @default(DRAFT)
  currentVersion Int                  @default(1)
  createdById    String               @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  campaign       MonthlyCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  versions       DeclarationVersion[]

  @@index([organizationId, status, deletedAt, id])
}

model DeclarationVersion {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  declarationId  String               @db.Uuid
  version        Int
  editorId       String               @db.Uuid
  changeSummary  String
  snapshot       Json
  diff           Json?
  approvalStatus ApprovalStatus       @default(PENDING)
  createdAt      DateTime             @default(now())
  declaration    PropheticDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([declarationId, version])
  @@index([organizationId, declarationId, createdAt, id])
}

model MediaAsset {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  name            String
  storageKey      String
  mimeType        String
  byteSize        BigInt
  checksum        String
  status          MediaAssetStatus @default(PENDING_UPLOAD)
  width           Int?
  height          Int?
  durationSeconds Int?
  metadata        Json?
  createdById     String           @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  primaryFor      BrandKit[]       @relation("PrimaryLogo")
  secondaryFor    BrandKit[]       @relation("SecondaryLogo")

  @@unique([organizationId, storageKey])
  @@index([organizationId, status, createdAt, deletedAt, id])
}

model Template {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  name           String
  type           ProjectType
  schemaVersion  Int           @default(1)
  content        Json
  status         ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, name, type])
  @@index([organizationId, type, status, deletedAt, id])
}

model FlyerProject {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  templateId     String?        @db.Uuid
  title          String
  canvas         Json
  status         ContentStatus  @default(DRAFT)
  renderStatus   RenderStatus   @default(NOT_STARTED)
  currentVersion Int            @default(1)
  createdById    String         @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  versions       FlyerVersion[]

  @@index([organizationId, status, renderStatus, deletedAt, id])
}

model FlyerVersion {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  flyerId        String         @db.Uuid
  version        Int
  editorId       String         @db.Uuid
  changeSummary  String
  snapshot       Json
  diff           Json?
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  flyer          FlyerProject   @relation(fields: [flyerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([flyerId, version])
  @@index([organizationId, flyerId, createdAt, id])
}

model VideoProject {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  templateId      String?       @db.Uuid
  title           String
  timeline        Json
  durationSeconds Int?
  status          ContentStatus @default(DRAFT)
  renderStatus    RenderStatus  @default(NOT_STARTED)
  renderProgress  Int           @default(0)
  createdById     String        @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@index([organizationId, status, renderStatus, deletedAt, id])
}

model SocialAccount {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @db.Uuid
  platform              SocialPlatform
  platformAccountId     String
  accountName           String
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  scopes                Json
  status                SocialAccountStatus @default(CONNECTED)
  lastSyncedAt          DateTime?
  connectedById         String              @db.Uuid
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  jobs                  PublishingJob[]

  @@unique([organizationId, platform, platformAccountId])
  @@index([organizationId, status, tokenExpiresAt, deletedAt, id])
}

model SocialPost {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  campaignId     String?             @db.Uuid
  title          String
  body           String
  content        Json?
  scheduledAt    DateTime?
  timezone       String
  status         SocialPostStatus    @default(DRAFT)
  approvalStatus ApprovalStatus      @default(PENDING)
  currentVersion Int                 @default(1)
  createdById    String              @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  jobs           PublishingJob[]
  versions       SocialPostVersion[]

  @@index([organizationId, status, scheduledAt, deletedAt, id])
}

model SocialPostVersion {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  socialPostId   String         @db.Uuid
  version        Int
  editorId       String         @db.Uuid
  changeSummary  String
  snapshot       Json
  diff           Json?
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  socialPost     SocialPost     @relation(fields: [socialPostId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([socialPostId, version])
  @@index([organizationId, socialPostId, createdAt, id])
}

model PublishingJob {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @db.Uuid
  socialPostId    String              @db.Uuid
  socialAccountId String              @db.Uuid
  platform        SocialPlatform
  scheduledAt     DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  status          PublishingJobStatus @default(PENDING)
  attemptCount    Int                 @default(0)
  maximumAttempts Int                 @default(5)
  platformPostId  String?
  platformPostUrl String?
  requestPayload  Json?
  responsePayload Json?
  errorCode       String?
  errorMessage    String?
  correlationId   String              @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  socialPost      SocialPost          @relation(fields: [socialPostId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  socialAccount   SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([socialPostId, socialAccountId])
  @@index([organizationId, status, scheduledAt, id])
}

model ApprovalRequest {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  resourceType       String
  resourceId         String          @db.Uuid
  requestedById      String          @db.Uuid
  assignedReviewerId String?         @db.Uuid
  status             ApprovalStatus  @default(PENDING)
  decisionNotes      String?
  requestedAt        DateTime        @default(now())
  reviewedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  comments           ReviewComment[]

  @@index([organizationId, status, requestedAt, deletedAt, id])
  @@index([organizationId, resourceType, resourceId])
}

model ReviewComment {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @db.Uuid
  approvalRequestId String          @db.Uuid
  userId            String          @db.Uuid
  parentCommentId   String?         @db.Uuid
  fieldPath         String?
  body              String
  resolvedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  approval          ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId, approvalRequestId, createdAt, deletedAt, id])
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  type           NotificationType
  title          String
  message        String
  actionUrl      String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId, userId, readAt, createdAt, id])
}

model AiGeneration {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  requestedById  String             @db.Uuid
  resourceType   String
  resourceId     String?            @db.Uuid
  generationType String
  provider       String
  model          String
  status         AiGenerationStatus @default(QUEUED)
  promptMetadata Json?
  outputMetadata Json?
  inputTokens    Int?
  outputTokens   Int?
  estimatedCost  Decimal?           @db.Decimal(12, 6)
  errorCode      String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status, createdAt, id])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  resourceType   String
  resourceId     String?  @db.Uuid
  beforeJson     Json?
  afterJson      Json?
  ipAddress      String?
  userAgent      String?
  correlationId  String   @db.Uuid
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt, id])
  @@index([organizationId, resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
}

model KnowledgeDocument {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  mediaAssetId   String?          @db.Uuid
  title          String
  sourceType     String
  status         IngestionStatus  @default(QUEUED)
  metadata       Json?
  createdById    String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  chunks         KnowledgeChunk[]
  jobs           IngestionJob[]

  @@index([organizationId, status, deletedAt, id])
}

model KnowledgeChunk {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  documentId     String             @db.Uuid
  sequence       Int
  content        String
  tokenCount     Int
  metadata       Json?
  embedding      EmbeddingMetadata?
  document       KnowledgeDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([documentId, sequence])
  @@index([organizationId, documentId, id])
}

model EmbeddingMetadata {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  chunkId        String         @unique @db.Uuid
  provider       String
  model          String
  dimensions     Int
  vectorKey      String
  contentHash    String
  createdAt      DateTime       @default(now())
  chunk          KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId, model, id])
}

model IngestionJob {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  documentId      String            @db.Uuid
  status          IngestionStatus   @default(QUEUED)
  attemptCount    Int               @default(0)
  maximumAttempts Int               @default(5)
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId, status, createdAt, id])
}

model RetrievalLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  queryHash      String
  filters        Json?
  resultChunkIds Json
  resultCount    Int
  durationMs     Int
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt, id])
}

model WebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String?       @db.Uuid
  provider        String
  externalEventId String
  eventType       String
  payload         Json
  signatureHash   String?
  status          WebhookStatus @default(RECEIVED)
  attemptCount    Int           @default(0)
  maximumAttempts Int           @default(5)
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?
  errorMessage    String?

  @@unique([provider, externalEventId])
  @@index([organizationId, status, receivedAt, id])
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @db.Uuid
  key            String
  scope          String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  lockedUntil    DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@unique([organizationId, scope, key])
  @@index([expiresAt])
}

model AnalyticsSnapshot {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  platform       SocialPlatform?
  period         AnalyticsPeriod
  periodStart    DateTime
  periodEnd      DateTime
  capturedAt     DateTime          @default(now())
  metrics        AnalyticsMetric[]

  @@unique([organizationId, platform, period, periodStart])
  @@index([organizationId, periodStart, id])
}

model AnalyticsMetric {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  snapshotId     String            @db.Uuid
  name           String
  value          Decimal           @db.Decimal(20, 4)
  dimensions     Json?
  snapshot       AnalyticsSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([snapshotId, name])
  @@index([organizationId, name, id])
}

model CalendarItem {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  type           CalendarItemType
  resourceId     String?          @db.Uuid
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  allDay         Boolean          @default(false)
  timezone       String
  createdById    String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@index([organizationId, startsAt, type, deletedAt, id])
}

model SystemSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  key            String
  value          Json
  isSecret       Boolean  @default(false)
  updatedById    String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, key])
}
